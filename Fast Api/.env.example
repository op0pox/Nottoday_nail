# 가중치는 Fast Api/models 의 pt 파일을 사용한다.
# seg_checkerboard.pt, seg_white.pt, cls_thumb.pt, cls_other.pt

# 체커보드 규격
SQUARES_X=
SQUARES_Y=
SQUARE_MM=
MARKER_MM=
CAMERA_HEIGHT_MM=
NAIL_HEIGHT_MM=

# 측면은 feat/nano-capture 거리식. 비우면 7.0cm.
# 정면은 세로 14mm, 가로 9.5mm 실측선으로 배율을 정한다.
# offset은 그 결과에 더하는 mm. 비우면 0.
SIDE_DISTANCE_CM=
FRONT_LENGTH_OFFSET_MM=
FRONT_WIDTH_OFFSET_MM=
SIDE_LENGTH_OFFSET_MM=
SIDE_WIDTH_OFFSET_MM=

# Jetson 촬영 서버. 비우면 화면의 Jetson 입력은 동작하지 않는다.
VITE_JETSON_URL=
